# Copy this file to .env and adjust if you want non-default behavior.
# Every value here has a built-in default, so an empty/missing .env is fine.

# Where the SQLite database file lives.
DB_PATH=data/jobs.db

# Sent as the User-Agent header on every page fetch. Identify yourself and
# leave a contact so a site owner can reach you if the bot misbehaves.
USER_AGENT=JobDiscoveryBot/0.1 (+contact: you@example.com)

# How long to wait for a page to respond before giving up.
REQUEST_TIMEOUT_SECONDS=10

# Pause between consecutive listing-page fetches on the same site (politeness delay).
CRAWL_DELAY_SECONDS=1

# Safety cap on how many paginated pages to follow per site.
MAX_PAGES_PER_SITE=20

# Static matcher (discovery/matcher.py) rule weights and relevance cutoff.
# A job scoring at or above STATIC_MATCH_THRESHOLD is marked 'relevant',
# otherwise 'rejected'. Excluded-keyword hits are always a hard reject
# regardless of these weights - see matcher.py.
KEYWORD_MATCH_WEIGHT=2
LOCATION_MATCH_WEIGHT=3
SALARY_MATCH_WEIGHT=2
STATIC_MATCH_THRESHOLD=3
